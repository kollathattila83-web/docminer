# Másold .env néven, és írd át a jelszót.
POSTGRES_USER=docminer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docminer
# Feldolgozók száma (docker compose up --scale worker=N is működik)
DOCMINER_WORKER_POLL_SECONDS=2
DOCMINER_MAX_UPLOAD_MB=100

# --- Google Cloud (EU) ---
# Próbaprofil (nincs költség): models.yaml; valódi szolgáltatók: models.google.yaml
DOCMINER_MODELS_FILE=models.yaml
GOOGLE_CLOUD_PROJECT=
DOCMINER_DOCAI_PROCESSOR_ID=
# Havi OCR-oldalkorlát: e fölött a feldolgozás megáll (a Document AI első 1 000 oldala ingyenes)
DOCMINER_OCR_MONTHLY_PAGE_LIMIT=1000
# A gcloud belépés mappája. Linux/Mac: ~/.config/gcloud
# Windows: C:/Users/<felhasználónév>/AppData/Roaming/gcloud
GCLOUD_CONFIG_DIR=~/.config/gcloud
